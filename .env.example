# Copy to .env and fill in. .env is gitignored; secrets never get committed.

# Postgres connection (psycopg 3 driver). Matches the compose db on host port 5433.
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5433/tracker

# OpenAI-compatible endpoint the agent talks to (a proxy sets these three at review time).
LLM_BASE_URL=https://api.openai.com/v1
# API key for the LLM endpoint — keep it out of version control.
LLM_API_KEY=sk-your-key-here
# Model id to request from the endpoint.
LLM_MODEL=gpt-5.5

# SEC requires a descriptive User-Agent on every EDGAR request: "Name email (purpose)".
SEC_USER_AGENT=Your Name your@email.com (Fundamentals Tracker)
